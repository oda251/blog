{
  "extends": "./node_modules/astro/tsconfigs/base",
  "compilerOptions": {
    "types": [],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@app/*": ["src/app/*"],
      "@components/*": ["src/components/*"],
      "@entities/*": ["src/entities/*"],
      "@features/*": ["src/features/*"],
      "@pages/*": ["src/pages/*"],
      "@repositories/*": ["src/repositories/*"],
      "@src/*": ["src/*"],
      "@public/*": ["public/*"],
    }
  },
  "include": ["src/**/*"]
}
