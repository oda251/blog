generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model Tags {
  id     String   @id @default(uuid())
  name   String   @unique @db.String(128)
  tweets Tweets[] @relation("TweetTags")
}

model Tweets {
  id         String    @id @default(uuid())
  content    String    @db.String(1024)
  article    String?   @db.String(16384)
  author     String?   @db.String(128)
  ip_address String?   @db.String(32)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  tags       Tags[]    @relation("TweetTags")
  vector     Vector[]

  @@index([id])
}

model Vector {
  id           String @id @default(uuid())
  source_id    String
  source_table String @db.String(128)
  embedding    String
  tweets       Tweets @relation(fields: [source_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// --- Article model ---
model Article {
  id         String   @id @default(uuid())
  title      String
  body       String
  author     String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// --- Product/devlangs/frameworks/infras models ---
enum DevLangCode {
  JS
  TS
  GAS
}

enum FrameworkCode {
  REACT
  ASTRO
  HONO
  TAILWIND
}

model DevLangRelation {
  id      String      @id @default(uuid())
  code    DevLangCode
  Product Product[]
}

model FrameworkRelation {
  id      String        @id @default(uuid())
  code    FrameworkCode
  Product Product[]
}

model Infra {
  id      String    @id @default(uuid())
  name    String    @unique
  Product Product[]
}

model Product {
  id         String              @id @default(uuid())
  title_en   String
  title_ja   String
  thumbnail  String?
  body       Json?
  github     String?
  href       String?
  langs      DevLangRelation[]
  frameworks FrameworkRelation[]
  infras     Infra[]
}
